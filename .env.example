# ReefScout environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# --- Required ---
# Personal Anthropic API key used by the agent loop.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional ---
# Override the agent model (default: claude-sonnet-4-6)
# REEFSCOUT_MODEL=claude-sonnet-4-6

# Local dev port. On Render this is provided automatically via $PORT.
# PORT=8000

# --- Firebase (optional: enables Google sign-in, conversation history, and the logbook) ---
# Public web-config values from Firebase console -> Project settings -> Your apps -> Web app.
# Injected into the page at runtime by the /firebase-config.js route, never committed.
# Leave blank to run without auth/history (chat still works).
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# FIREBASE_PROJECT_ID=your-project
# FIREBASE_APP_ID=
