# ReefScout environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# --- Required ---
# Personal Anthropic API key used by the agent loop.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional ---
# Override the agent model (default: claude-sonnet-4-6)
# REEFSCOUT_MODEL=claude-sonnet-4-6

# Local dev port. On Render this is provided automatically via $PORT.
# PORT=8000
