rules_version = '2';

// ReefScout Firestore security rules.
// Each user can read and write ONLY their own conversations. Nothing is public.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/conversations/{conversationId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Naturalist logbook: wildlife sightings + logged trips. Same per-user scoping.
    match /users/{uid}/sightings/{sightingId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/trips/{tripId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
